APP_NAME="NYVEX Revenue Ops Copilot"
APP_ENV=local
LOG_LEVEL=INFO

# App database / infra/app docker compose
APP_POSTGRES_USER=revenue_ops
APP_POSTGRES_PASSWORD=generate-local-secret
APP_POSTGRES_DB=revenue_ops_copilot
APP_POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://revenue_ops:generate-local-secret@localhost:5434/revenue_ops_copilot

# Local/demo input
FAKE_SHEET_PATH=examples/leads_demo.csv

# OpenAI / LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MONTHLY_TOKEN_BUDGET=0
OPENAI_MONTHLY_USD_BUDGET=0

# Enrichment agent
ENRICHMENT_PROVIDER=openai
ENRICHMENT_MODEL=gpt-5.4-mini
ENRICHMENT_REASONING_EFFORT=medium
ENRICHMENT_MAX_URLS_PER_LEAD=5
ENRICHMENT_HTTP_TIMEOUT_SECONDS=20
ENRICHMENT_MIN_CONFIDENCE_TO_DRAFT=65
ENRICHMENT_REQUIRE_EVIDENCE=true
ENRICHMENT_MAX_ITERATIONS=5
ENRICHMENT_MAX_HTML_BYTES=500000
DUCKDUCKGO_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
GITHUB_API_TOKEN=replace-with-github-token-or-leave-empty
SUPPORTED_COUNTRIES=Mexico,Colombia,Chile,Peru,Argentina,Uruguay,Costa Rica,Panama,Spain
UNSUPPORTED_COUNTRIES=Brazil,Brasil

# Google Sheets / Gmail
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_SHEETS_DEFAULT_TAB=Leads
GOOGLE_SHEETS_RUNS_TAB=Runs
GOOGLE_SHEETS_EMAIL_DRAFTS_TAB=Email Drafts
GOOGLE_SHEETS_IMPORTS_TAB=Imports
GOOGLE_SHEETS_ENRICHMENT_TAB=Enrichment
GOOGLE_SHEETS_SOURCE_CANDIDATES_TAB=Source Candidates
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-google-refresh-token-or-leave-empty

# Self-hosted Langfuse
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-project-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-project-secret-key

# Runtime limits / Apps Script
MANUAL_RUN_LIMIT=10
SCHEDULED_BATCH_LIMIT=50
LOCK_EXPIRY_MINUTES=30
ROW_TIMEOUT_SECONDS=120
MAX_REVISION_COUNT_WITHOUT_OVERRIDE=2
APPS_SCRIPT_SHARED_SECRET=generate-local-secret

# Apollo
APOLLO_API_KEY=replace-with-apollo-api-key-or-leave-empty
APOLLO_BASE_URL=https://api.apollo.io
APOLLO_MAX_CANDIDATES_PER_RUN=50
APOLLO_ENRICH_EMAILS=false
APOLLO_EMAIL_ENRICHMENT_MIN_SCORE=75
APOLLO_MONTHLY_CREDIT_BUDGET=2500
APOLLO_MIN_CANDIDATE_SCORE=60

# Optional summary email
SUMMARY_EMAIL_TO=
SUMMARY_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional CRM
HUBSPOT_PRIVATE_APP_TOKEN=
