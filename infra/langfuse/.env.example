# Copy this file to .env in this directory before running docker compose.
# Generate secrets with:
#   openssl rand -base64 32
#   openssl rand -hex 32

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-nextauth-secret
SALT=replace-with-salt
ENCRYPTION_KEY=replace-with-64-hex-char-encryption-key
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-langfuse-postgres-password
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:replace-with-langfuse-postgres-password@postgres:5432/postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=replace-with-clickhouse-password
CLICKHOUSE_CLUSTER_ENABLED=false

REDIS_AUTH=replace-with-redis-password

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-minio-password

LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=replace-with-minio-password
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/

LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=replace-with-minio-password
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9090
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
LANGFUSE_S3_BATCH_EXPORT_REGION=auto
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://minio:9000
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://localhost:9090
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=replace-with-minio-password
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true

LANGFUSE_INIT_ORG_ID=nyvex
LANGFUSE_INIT_ORG_NAME=NYVEX
LANGFUSE_INIT_PROJECT_ID=revenue-ops-copilot
LANGFUSE_INIT_PROJECT_NAME=Revenue Ops Copilot
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=replace-with-langfuse-project-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=replace-with-langfuse-project-secret-key
LANGFUSE_INIT_USER_EMAIL=replace-with-your-email
LANGFUSE_INIT_USER_NAME=Bruno
LANGFUSE_INIT_USER_PASSWORD=replace-with-langfuse-user-password
